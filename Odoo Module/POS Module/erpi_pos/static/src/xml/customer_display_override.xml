<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Override Template Layar Pelanggan Odoo 17 (Split Layout: Kiri Daftar Belanja, Kanan Carousel Promo / QRIS) -->
    <t t-name="point_of_sale.CustomerFacingDisplayOrderLines" t-inherit="point_of_sale.CustomerFacingDisplayOrderLines" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos_orderlines_list')]" position="replace">
            <div class="erpi-cfd-split-container">
                <!-- SISI KIRI: Item Belanja Kasir (Tanpa Gambar Produk, Bersih, Teks Terbaca) -->
                <div class="erpi-cfd-left-pane">
                    <div class="erpi-items-table-header">
                        <span class="col-item">Item Pesanan</span>
                        <span class="col-qty">Qty</span>
                        <span class="col-price">Harga</span>
                    </div>
                    <div class="erpi-items-scroll">
                        <div t-foreach="order.get_orderlines()" t-key="orderline.id" t-as="orderline" class="erpi-item-row" t-att-class="{ 'selected-row': orderline.id === order.get_selected_orderline().id }">
                            <div class="col-item item-main">
                                <div class="item-name" t-esc="orderline.get_full_product_name()" />
                                <t t-if="orderline.get_discount_str() !== '0'">
                                    <div class="item-discount">Diskon <t t-esc="orderline.get_discount_str()" />%</div>
                                </t>
                                <t t-if="orderline.get_customer_note()">
                                    <div class="item-note">Note: <t t-esc="orderline.get_customer_note()" /></div>
                                </t>
                            </div>
                            <div class="col-qty item-qty">
                                <span t-esc="orderline.get_quantity_str()" />
                            </div>
                            <div class="col-price item-subtotal">
                                <span t-esc="pos.env.utils.formatCurrency(orderline.get_display_price())" />
                            </div>
                        </div>
                    </div>

                    <!-- Ringkasan Subtotal, Diskon & Total -->
                    <div class="erpi-cfd-summary-box">
                        <div class="summary-line">
                            <span>Subtotal</span>
                            <span t-esc="pos.env.utils.formatCurrency(order.get_total_without_tax())" />
                        </div>
                        <t t-if="order.get_total_discount() > 0">
                            <div class="summary-line discount-line">
                                <span>Total Diskon</span>
                                <span>- <t t-esc="pos.env.utils.formatCurrency(order.get_total_discount())" /></span>
                            </div>
                        </t>
                        <div class="summary-line">
                            <span>Pajak (PB1)</span>
                            <span t-esc="pos.env.utils.formatCurrency(order.get_total_tax())" />
                        </div>
                        <div class="summary-line total-highlight">
                            <span>TOTAL BAYAR</span>
                            <span class="amount-val" t-esc="pos.env.utils.formatCurrency(order.get_total_with_tax())" />
                        </div>
                    </div>
                </div>

                <!-- SISI KANAN: Carousel Banner Promo / QRIS Promosi -->
                <div class="erpi-cfd-right-pane">
                    <div class="erpi-promo-carousel">
                        <div class="promo-card active" id="erpiPromoSlide">
                            <div class="promo-tag">Spesial Promo</div>
                            <div class="promo-title">Paket Kombo Hemat Kasir</div>
                            <div class="promo-desc">Diskon hingga 20% untuk pembelian menu kombo hari ini. Tanyakan kasir untuk info lebih lanjut!</div>
                        </div>
                        <div class="promo-dots">
                            <span class="dot active"></span>
                            <span class="dot"></span>
                            <span class="dot"></span>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </t>

</templates>
