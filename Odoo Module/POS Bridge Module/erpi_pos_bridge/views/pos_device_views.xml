<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- POS Device Form View -->
    <record id="view_pos_device_form" model="ir.ui.view">
        <field name="name">pos.device.form</field>
        <field name="model">pos.device</field>
        <field name="arch" type="xml">
            <form string="POS Device">
                <header>
                    <button name="action_activate_device" string="Activate" type="object"
                            class="oe_highlight" invisible="status == 'active'"/>
                    <button name="action_generate_emergency_otp" string="Generate Emergency OTP"
                            type="object" class="btn-warning" invisible="status != 'active'"/>
                    <button name="action_suspend_device" string="Suspend" type="object"
                            class="btn-secondary" invisible="status in ('suspended', 'revoked')"/>
                    <button name="action_revoke_device" string="Revoke" type="object"
                            class="btn-danger" invisible="status == 'revoked'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="pending,active,suspended,revoked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Smartlogic C8G Front Cashier"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Device Information">
                            <field name="device_uuid"/>
                            <field name="pairing_code"/>
                            <field name="device_token" password="True"/>
                            <field name="app_version"/>
                            <field name="last_heartbeat"/>
                        </group>
                        <group string="POS &amp; Hardware Assignment">
                            <field name="pos_config_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="printer_ip" placeholder="e.g. 192.168.1.200"/>
                        </group>
                    </group>
                    <group string="Emergency Kiosk Bypass" invisible="not emergency_otp">
                        <field name="emergency_otp"/>
                        <field name="emergency_otp_expired"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- POS Device Tree View -->
    <record id="view_pos_device_tree" model="ir.ui.view">
        <field name="name">pos.device.tree</field>
        <field name="model">pos.device</field>
        <field name="arch" type="xml">
            <tree string="POS Devices" decoration-success="status == 'active'"
                  decoration-muted="status == 'revoked'" decoration-warning="status == 'suspended'">
                <field name="name"/>
                <field name="pos_config_id"/>
                <field name="device_uuid"/>
                <field name="status" widget="badge"/>
                <field name="app_version"/>
                <field name="last_heartbeat"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- POS Device Action -->
    <record id="action_pos_device" model="ir.actions.act_window">
        <field name="name">POS Devices</field>
        <field name="res_model">pos.device</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new POS Android tablet device
            </p>
        </field>
    </record>

    <!-- POS Branding Form View -->
    <record id="view_pos_branding_form" model="ir.ui.view">
        <field name="name">pos.branding.form</field>
        <field name="model">pos.branding</field>
        <field name="arch" type="xml">
            <form string="Customer Display Branding">
                <sheet>
                    <group>
                        <group string="Brand Identity">
                            <field name="brand_name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="primary_color" widget="color"/>
                            <field name="secondary_color" widget="color"/>
                        </group>
                        <group string="Logo">
                            <field name="logo_image" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="CFD Carousel Banners">
                            <field name="banner_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="image" widget="image" options="{'size': [90, 90]}"/>
                                    <field name="display_duration_seconds"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- POS Branding Tree View -->
    <record id="view_pos_branding_tree" model="ir.ui.view">
        <field name="name">pos.branding.tree</field>
        <field name="model">pos.branding</field>
        <field name="arch" type="xml">
            <tree string="CFD Branding">
                <field name="brand_name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="primary_color"/>
                <field name="secondary_color"/>
            </tree>
        </field>
    </record>

    <!-- POS Branding Action -->
    <record id="action_pos_branding" model="ir.actions.act_window">
        <field name="name">CFD Branding</field>
        <field name="res_model">pos.branding</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Items under Point of Sale Configuration -->
    <menuitem id="menu_pos_device_config"
              name="POS Devices"
              parent="point_of_sale.menu_point_config_product"
              action="action_pos_device"
              sequence="50"/>

    <menuitem id="menu_pos_branding_config"
              name="CFD Branding"
              parent="point_of_sale.menu_point_config_product"
              action="action_pos_branding"
              sequence="55"/>
</odoo>
